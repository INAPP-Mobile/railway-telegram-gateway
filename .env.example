# Required: auth key for the WebSocket gateway and the Admin API.
# Set a strong unique value. Accepts comma-separated keys (for rotation).
GATEWAY_API_KEY=

# Public URL used when registering each bot's Telegram webhook
# (<BASE_URL>/webhook/bot/<botId>). Railway's public domain is detected
# automatically at runtime; only set this to pin a custom domain.
BASE_URL=

# --- Persistence -----------------------------------------------------------
# Without a volume the bot registry and outbound queue live in the container
# filesystem and are lost on redeploy. Attach a volume to get durability.
# Railway sets RAILWAY_VOLUME_MOUNT_PATH automatically when a volume is mounted;
# the DB is written to <that path>/bots.db.
# Override the DB location directly (wins over the volume path):
DATABASE_PATH=
# Or move the data dir without attaching a volume:
GATEWAY_DATA_DIR=

# --- Outbound messaging rate limits (see src/rate-limiter.ts) ---------------
# Sustained sends/second per bot. Telegram hard cap: 30/s per bot.
RATE_LIMIT_GLOBAL_PER_SEC=29
# Sustained sends/second per chat. Telegram sustained cap: ~1/s per chat.
RATE_LIMIT_CHAT_PER_SEC=1
# Max per-chat sends inside the sliding window (Telegram resets a 20-30 window).
RATE_LIMIT_CHAT_WINDOW_CAP=20
# Sliding window length for the per-chat cap, in ms.
RATE_LIMIT_CHAT_WINDOW_MS=120000
# Retries after HTTP 429, honoring retry_after.
RATE_LIMIT_MAX_RETRIES=3
# Cap on a single retry_after sleep, ms (Telegram may advertise 300s+).
RATE_LIMIT_MAX_RETRY_AFTER_MS=60000

# --- Durable outbox (see src/outbox-worker.ts) -----------------------------
# How often the worker scans for due messages, ms.
OUTBOX_POLL_MS=250
# Max messages claimed per drain.
OUTBOX_BATCH=32
# Delivery attempts before a message is dead-lettered.
OUTBOX_MAX_ATTEMPTS=5
# First retry delay, ms. Each subsequent retry multiplies by OUTBOX_BASE_FACTOR.
OUTBOX_BASE_DELAY_MS=30000
OUTBOX_BASE_FACTOR=1.5
# Ceiling on any single backoff, ms.
OUTBOX_MAX_DELAY_MS=300000

# WebSocket ping interval in milliseconds.
WEBSOCKET_HEARTBEAT_INTERVAL=30000

# Skip Telegram getMe validation (set to "true" only for local dev).
SKIP_BOT_VALIDATION=false

# Server port (Railway sets this automatically).
PORT=3000
