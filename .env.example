# Required: Auth key for WebSocket & Admin API. Set a strong unique value.
# Accepts comma-separated keys.
GATEWAY_API_KEY=

# Public URL for bot webhook registration. Railway auto-sets this at runtime.
# Only set if using a custom domain.
BASE_URL=

# Telegram webhook secret for update verification.
WEBHOOK_SECRET=

# --- Outbound messaging rate limits (see src/rate-limiter.ts for rationale) ---
# Sustained sends/second per bot. Telegram hard cap: 30/s global per bot.
RATE_LIMIT_GLOBAL_PER_SEC=29
# Sustained sends/second per chat. Telegram sustained cap: ~1/s per chat.
RATE_LIMIT_CHAT_PER_SEC=1
# Max per-chat sends inside the sliding window (Telegram resets a 20-30 message window).
RATE_LIMIT_CHAT_WINDOW_CAP=20
# Sliding window length for the per-chat cap, in ms.
RATE_LIMIT_CHAT_WINDOW_MS=120000
# Retries after HTTP 429, honoring retry_after.
RATE_LIMIT_MAX_RETRIES=3
# Cap on a single retry_after sleep, ms (Telegram may advertise 300s+ for long bans).
RATE_LIMIT_MAX_RETRY_AFTER_MS=60000

# Max bot subscriptions per WebSocket client.
SUBSCRIPTION_MAX_PER_CLIENT=10

# WebSocket ping interval in milliseconds.
WEBSOCKET_HEARTBEAT_INTERVAL=30000

# Skip Telegram getMe validation (set to "true" for local dev).
SKIP_BOT_VALIDATION=false

# Server port (Railway sets this automatically).
PORT=3000
