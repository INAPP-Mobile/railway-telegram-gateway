# ─── Required ────────────────────────────────────────────
# Set a strong, unique key. This gates all API + WebSocket access.
# Accepts comma-separated values for multiple keys.
GATEWAY_API_KEY=

# ─── Optional — Webhook ──────────────────────────────────
# Railway auto-sets your public URL. Only set this if you need
# a custom domain or are running outside Railway.
BASE_URL=

# Telegram webhook secret for update verification.
# If set, Telegram signs every request with this secret.
WEBHOOK_SECRET=

# ─── Optional — Rate Limits ──────────────────────────────
# Max number of bot subscriptions per WebSocket client.
SUBSCRIPTION_MAX_PER_CLIENT=10

# ─── Optional — WebSocket ────────────────────────────────
# Ping interval in milliseconds. Keeps idle connections alive.
WEBSOCKET_HEARTBEAT_INTERVAL=30000

# ─── Optional — Validation ───────────────────────────────
# Set to "true" to skip Telegram getMe validation.
# Useful for local dev when your bot token isn't ready.
SKIP_BOT_VALIDATION=false

# ─── Server (Railway sets this automatically) ───────────
PORT=3000
